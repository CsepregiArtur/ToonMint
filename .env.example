# ---------------------------------------------------------------------------
# ToonMint – variabile de mediu
# Copiază acest fișier în .env și completează valorile reale.
# Fișierul .env nu se comite în git.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
SERVER_PORT=8080
# Minim 32 de caractere; obligatoriu în producție.
JWT_SECRET=schimba-ma-cu-un-secret-de-minim-32-caractere
# Origini permise pentru browser (separate prin virgulă). În producție trebuie să
# includă și originile din care rulează aplicațiile Capacitor, altfel cererile din
# aplicație sunt respinse: `capacitor://localhost` (iOS), `https://localhost`
# (Android) și `http://localhost` (Android, scheme vechi).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (profil `prod`) -------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/toonmint
DB_USERNAME=toonmint
DB_PASSWORD=toonmint

# --- Redis (rate limiting + cache temporar, profil `prod`) ----------------
# Opțional pentru o singură instanță: setează ambele backend-uri pe `memory`
# și REDIS_HEALTH_ENABLED=false ca să rulezi fără Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RATE_LIMIT_BACKEND=redis
TEMP_STORE_BACKEND=redis
REDIS_HEALTH_ENABLED=true

# --- Generare imagini -----------------------------------------------------
# `stub` = funcționează offline (filtru local, fără cost).
# `gemini` = apel real către Google Gemini.
AI_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Prefixul public al imaginilor de exemplu pentru stiluri (servite de frontend).
STYLE_PREVIEW_BASE_URL=/demo/styles
# Repară job-urile rămase fără worker (reluare sau FAILED + rambursare).
# Pune `false` doar dacă rulează mai multe instanțe pe aceeași bază.
JOB_RECOVERY_ENABLED=true
# De la ce durată un job PROCESSING e considerat abandonat (peste durata maximă
# a unei generări: max-attempts x timeout-ul AI).
JOB_MAX_PROCESSING=PT10M

# --- Email (Google / Gmail SMTP) -----------------------------------------
# true = trimite efectiv; false = doar loghează (util în dezvoltare).
# Codurile OTP de verificare email / resetare parolă sunt scrise în log când e false.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Adresa Gmail completă.
MAIL_USERNAME=
# Parola de aplicație Google (16 caractere), NU parola contului.
MAIL_PASSWORD=
MAIL_FROM_NAME=ToonMint

# --- Legal -----------------------------------------------------------------
# Versiunea documentelor legale (termeni + confidențialitate + cookie-uri).
# O SINGURĂ valoare pentru tot proiectul: backendul o validează la înregistrare și
# la checkout, iar frontendul o afișează și o trimite (`vite.config.js` o citește din
# acest fișier). Când modifici textele legale: schimbi data aici **și** rulezi
# `npm run build` în frontend, altfel utilizatorii cu bundle vechi primesc
# 409 TERMS_VERSION_OUTDATED până reîncarcă pagina.
LEGAL_TERMS_VERSION=2026-10-31

# --- RevenueCat -----------------------------------------------------------
# Valoarea trimisă de RevenueCat în header-ul Authorization al webhook-ului.
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Baza linkului Web Purchase Link (https://pay.rev.cat/<token>), fără query string:
# backendul adaugă app user id în path. Acceptă și `{app_user_id}` ca placeholder.
# Proiect RevenueCat `d6c976c5`, offering `default` (weekly + yearly + 20 credite).
REVENUECAT_PURCHASE_LINK_URL=https://pay.rev.cat/torxtsegooxbshvr
REVENUECAT_ENTITLEMENT_ID=pro

# --- Bookkeeping (registrul financiar) ------------------------------------
# Moneda în care se raportează toate sumele.
FINANCE_REPORTING_CURRENCY=USD
# Costul estimat al unei imagini generate (înregistrat ca cheltuială per job finalizat).
FINANCE_COST_PER_GENERATION=0.034
# Cursuri către moneda de raportare, prin relaxed binding, ex.:
# APP_FINANCE_FX_RATES_EUR=1.08

# --- Cont operator creat automat la primul start (opțional) ---------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Login demo (doar în dezvoltare) -------------------------------------
# true în profilul `dev`; profilul `prod` îl forțează pe false.
DEMO_LOGIN_ENABLED=true
DEMO_USER_EMAIL=demo@toonmint.local
DEMO_USER_PASSWORD=demo12345
DEMO_USER_CREDITS=25
DEMO_ADMIN_EMAIL=operator@toonmint.local
DEMO_ADMIN_PASSWORD=operator12345
DEMO_ADMIN_CREDITS=100
