# ---------------------------------------------------------------------------
# ToonMint – frontend (Vite). Copiază în `frontend/.env.local` și completează.
#
# Aceste valori ajung în bundle-ul public (sunt identificatori publici, nu
# secrete). Lasă-le GOALE până creezi conturile: fără ID, eticheta respectivă
# nu se încarcă deloc, iar aplicația funcționează normal.
#
# IMPORTANT: nu refolosi ID-urile unui alt domeniu. GA4 ar amesteca două site-uri
# într-o singură proprietate, iar AdSense ar atribui altfel inventarul.
#
# Versiunea documentelor legale NU se setează aici: `LEGAL_TERMS_VERSION` stă în
# `.env.example` din rădăcina repo-ului, pentru că o citește și backendul.
# ---------------------------------------------------------------------------

# Google Tag Manager (container) — ex. GTM-N6Z7H8R5
VITE_GTM_ID=

# Google Analytics 4 (web stream) — ex. G-T79F0V5PLX
VITE_GA4_ID=

# Google AdSense (publisher ID, cu prefixul „ca-”) — ex. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=

# Microsoft Clarity (project ID) — ex. z0u2mws6ze
VITE_CLARITY_ID=

# ---------------------------------------------------------------------------
# Aplicații mobile (Capacitor). Se setează doar la build-ul nativ; pe web
# rămân goale și totul funcționează ca înainte.
#
# Adresa API: în WebView `/api` ar fi relativ la `capacitor://localhost`, deci
# trebuie completă. Se decomentează DOAR pentru build-urile mobile — pe web
# `/api` trebuie să rămână relativ (nginx face proxy). Fără slash final.
# VITE_API_BASE_URL=https://toonmint.cs-hub.xyz/api

# Cheile publice RevenueCat (SDK keys), una per platformă. Nu sunt secrete.
# Cheia secretă rămâne doar pe server, pentru webhook.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
