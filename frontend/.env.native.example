# ---------------------------------------------------------------------------
# ToonMint – variabile pentru build-ul nativ (Capacitor).
#
# Copiază acest fișier în `.env.native.local` (ignorat de git) și completează.
# Se încarcă doar la `npm run build:native` (`vite build --mode native`), deci
# build-ul web rămâne cu `/api` relativ, exact ce așteaptă nginx.
# ---------------------------------------------------------------------------

# API-ul public, fără slash final. Într-un WebView `/api` ar fi relativ la
# `capacitor://localhost`, nu la server, deci adresa trebuie să fie completă.
VITE_API_BASE_URL=https://toonmint.cs-hub.xyz/api

# Cheile publice RevenueCat (SDK keys): RevenueCat → Project settings → API keys
# → App Store / Play Store. Nu sunt secrete, ajung oricum în bundle.
# Fără ele aplicația pornește, dar cumpărările eșuează cu „RevenueCat API key is
# not configured for this platform”.
#
# Pentru dezvoltare fără conturi în magazine poți pune aici cheia de **Test Store**
# (`test_…`): RevenueCat → Apps and providers → secțiunea Test configuration.
# Este aceeași cheie pe ambele platforme și cumpărările trec prin SDK ca cele
# reale, dar SDK-ul refuză să pornească într-un build Release cu o cheie `test_…`.
# Deci: numai build de Debug, niciodată într-un build urcat în magazine.
# Cheia se poate pune direct, fără dashboard:
#   node scripts/fetch-test-store-key.mjs test_… --write
# sau, cu o cheie secretă v2 (API Version 2), o citește din API:
#   REVENUECAT_SECRET_API_KEY=sk_… node scripts/fetch-test-store-key.mjs --write
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Dezvoltare locală fără conturi în magazine și fără chei RevenueCat: cumpărările
# sunt simulate, deci fluxul din UI poate fi parcurs în simulator/emulator.
# Creditele NU sunt acordate (vin doar prin webhook-ul RevenueCat), iar build-ul
# nu trebuie urcat în magazine.
VITE_NATIVE_PURCHASE_STUB=false
